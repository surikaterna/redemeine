{
  "name": "redemeine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "description": "Sane defaults CQRS/ES aggregates library",
  "author": "Your Name/Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/redemeine.git"
  },
  "main": "dist/cjs/redemeine.js",
  "module": "dist/esm/redemeine.js",
  "types": "dist/types/redemeine.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "redemeine": "./dist/cjs/bin/redemeine.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/redemeine.d.ts",
      "import": "./dist/esm/redemeine.js",
      "require": "./dist/cjs/redemeine.js",
      "default": "./dist/cjs/redemeine.js"
    },
    "./reflector": {
      "types": "./dist/types/reflector.d.ts",
      "import": "./dist/esm/reflector.js",
      "require": "./dist/cjs/reflector.js",
      "default": "./dist/cjs/reflector.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:turbo",
    "build:turbo": "turbo run build --continue",
    "build:legacy": "node ./bin/build-dual.js",
    "build:cjs": "pnpm exec tsc -p tsconfig.build.cjs.json",
    "build:esm": "pnpm exec tsc -p tsconfig.build.esm.json",
    "watch": "tsc -w",
    "test": "pnpm run test:turbo",
    "test:turbo": "turbo run test --continue",
    "test:legacy": "pnpm exec jest",
    "test:watch": "jest --watchAll",
    "typecheck": "pnpm run typecheck:turbo",
    "typecheck:turbo": "turbo run typecheck --continue",
    "typecheck:legacy": "pnpm exec tsc -p ./",
    "test-compile": "pnpm run typecheck:legacy",
    "lint": "pnpm run lint:principles && pnpm run lint:turbo",
    "lint:turbo": "turbo run lint --continue",
    "lint:principles": "node ./bin/check-code-principles.js",
    "lint:legacy": "pnpm exec eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "docs:typedoc": "typedoc",
    "docs:audit": "tsx bin/redemeine-reflector.ts --verify-tsdoc",
    "docs:llms": "tsx bin/redemeine-reflector.ts --generate-llms-ctx > llms.txt",
    "docs:install": "pnpm --dir website install",
    "docs:dev": "pnpm --dir website run start",
    "docs:build": "pnpm run docs:install && pnpm --dir website run build",
    "check:projection-runtime-boundaries": "node ./bin/check-projection-runtime-boundaries.js",
    "verify:workspace": "pnpm exec turbo run typecheck build test --continue"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.0",
    "@jest/globals": "^30.3.0",
    "@types/node": "^24.7.2",
    "@types/jest": "^30.0.0",
    "docusaurus-plugin-typedoc": "^1.4.2",
    "eslint": "^8.57.1",
    "eslint-config-surikat": "^5.0.0",
    "jest": "^29.7.0",
    "prettier-config-surikaterna": "^1.0.1",
    "ts-jest": "^29.1.5",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-missing-exports": "^4.1.2",
    "tsup": "^8.4.0",
    "turbo": "^2.5.3",
    "typescript": "^5.9.3",
    "utility-types": "^3.11.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "type-fest": "^5.5.0"
  },
  "peerDependencies": {
    "zod": "^3.0.0"
  }
}

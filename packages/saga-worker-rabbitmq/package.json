{
  "name": "@redemeine/saga-worker-rabbitmq",
  "version": "0.1.0",
  "description": "RabbitMQ manual-ack worker for durable saga turns",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm exec jest --config ../../jest.config.js --roots packages/saga-worker-rabbitmq/test && node --test scripts/topology-runner-core.test.mjs scripts/topology-runner-ownership.test.mjs scripts/topology-runner-receipt.test.mjs scripts/topology-runner-readiness.test.mjs scripts/topology-diagnostic-core.test.mjs",
    "test:integration:real": "node ./scripts/run-real-stack.mjs",
    "test:topology:real": "node ./scripts/run-topology-real.mjs",
    "diagnose:topology:startup": "node ./scripts/run-topology-diagnostic.mjs",
    "typecheck:integration": "tsc --noEmit -p tsconfig.integration.json",
    "lint": "tsc --noEmit"
  },
  "private": true,
  "dependencies": {
    "@redemeine/saga-runtime": "workspace:*",
    "amqplib": "2.0.1"
  },
  "devDependencies": {
    "@redemeine/aggregate": "workspace:*",
    "@redemeine/kernel": "workspace:*",
    "@redemeine/saga": "workspace:*",
    "@redemeine/saga-runtime-store-tapeworm": "workspace:*",
    "mongodb": "6.21.0",
    "tapeworm": "0.6.0",
    "tapeworm_dispatcher_mdb_rmq": "0.2.0",
    "tapeworm_persistence_store_mongodb": "3.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}

{
  "name": "@redemeine/demeine-interop",
  "version": "0.1.0-pre.1",
  "description": "Standalone legacy-compatible aggregate lifecycle for Redemeine builders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/redemeine.git",
    "directory": "packages/demeine-interop"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm exec jest --config ../../jest.config.js --roots packages/demeine-interop/test --runInBand",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@redemeine/kernel": "workspace:*",
    "@types/node": "24.13.2",
    "bluebird": "3.7.2",
    "events": "3.3.0",
    "p-queue": "6.6.2",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@redemeine/aggregate": "workspace:*",
    "@types/bluebird": "3.5.42",
    "@types/uuid": "9.0.8",
    "demeine": "1.3.0",
    "tapeworm": "0.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}

{
  "name": "@redemeine/mirage",
  "version": "1.0.0-pre.6",
  "description": "Type-safe live aggregate proxies with readonly state, scoped commands and event-store persistence",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/redemeine.git",
    "directory": "packages/mirage"
  },
  "homepage": "https://github.com/surikaterna/redemeine/tree/main/packages/mirage#readme",
  "bugs": {
    "url": "https://github.com/surikaterna/redemeine/issues"
  },
  "keywords": [
    "redemeine",
    "cqrs",
    "event-sourcing",
    "testing",
    "mock",
    "in-memory",
    "repository"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:types && pnpm exec jest --config ../../jest.config.js --roots packages/mirage/test",
    "test:types": "tsc -p tsconfig.contracts.json && tsc -p tsconfig.declarations.json",
    "test:packed": "node qualification/packed-dx.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@redemeine/aggregate": "workspace:*",
    "@redemeine/kernel": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}

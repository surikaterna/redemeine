{
  "name": "@redemeine/mirage",
  "version": "0.2.0-pre.0",
  "description": "In-memory aggregate repository for testing event-sourced systems",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/redemeine.git",
    "directory": "packages/mirage"
  },
  "homepage": "https://github.com/surikaterna/redemeine/tree/main/packages/mirage#readme",
  "bugs": {
    "url": "https://github.com/surikaterna/redemeine/issues"
  },
  "keywords": [
    "redemeine",
    "cqrs",
    "event-sourcing",
    "testing",
    "mock",
    "in-memory",
    "repository"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm exec jest --config ../../jest.config.js --roots packages/mirage/test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@redemeine/aggregate": "workspace:*",
    "@redemeine/kernel": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}

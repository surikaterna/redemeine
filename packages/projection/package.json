{
  "name": "@redemeine/projection",
  "version": "0.2.0-pre.4",
  "description": "Projection builder for deriving read models from event streams",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/redemeine.git",
    "directory": "packages/projection"
  },
  "homepage": "https://github.com/surikaterna/redemeine/tree/main/packages/projection#readme",
  "bugs": {
    "url": "https://github.com/surikaterna/redemeine/issues"
  },
  "keywords": [
    "redemeine",
    "cqrs",
    "event-sourcing",
    "projection",
    "read-model",
    "event-handler"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:types && pnpm exec jest --config ../../jest.config.js --roots packages/projection/test --testPathIgnorePatterns='.*e2e.*|.*integration.*|.*e5-1.*'",
    "test:types": "tsc --noEmit --strict --skipLibCheck false --module ES2022 --moduleResolution Bundler --target ES2022 test/resolved-event-types.ts test/resolved-event-routing.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "immer": "11.2.10"
  },
  "devDependencies": {
    "@redemeine/aggregate": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}

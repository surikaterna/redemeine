{
  "name": "@redemeine/cli",
  "version": "0.2.0-pre.1",
  "description": "Domain scaffolding and compiler-only schema extraction for Redemeine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/redemeine.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "redemeine": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/reflector.d.ts",
      "import": "./dist/reflector.js"
    },
    "./reflector": {
      "types": "./dist/reflector.d.ts",
      "import": "./dist/reflector.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm exec jest --config ../../jest.config.js --roots packages/cli/test",
    "test:packed": "node test/packedSmoke.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@redemeine/kernel": "workspace:*",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsup": "^8.5.1"
  }
}

{
  "name": "@redemeine/aggregate",
  "version": "1.0.0-pre.4",
  "description": "Event-sourced aggregate builder with type-safe command handlers and state reducers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/redemeine.git",
    "directory": "packages/aggregate"
  },
  "homepage": "https://github.com/surikaterna/redemeine/tree/main/packages/aggregate#readme",
  "bugs": {
    "url": "https://github.com/surikaterna/redemeine/issues"
  },
  "keywords": [
    "redemeine",
    "cqrs",
    "event-sourcing",
    "ddd",
    "aggregate",
    "domain-driven-design",
    "state-machine"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && pnpm run typecheck:envelopes && pnpm run typecheck:plugins",
    "typecheck:envelopes": "tsc --noEmit -p tsconfig.envelopes.json",
    "typecheck:plugins": "tsc --noEmit -p test/typefixtures/aggregate-plugins/tsconfig.json",
    "test": "pnpm exec jest --config ../../jest.config.js --roots packages/aggregate/test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@redemeine/kernel": "workspace:*",
    "immer": "^10.1.1"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}

{
  "name": "@redemeine/testing",
  "version": "0.2.0-pre.0",
  "description": "Test utilities and harnesses for @redemeine event-sourced applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/redemeine.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/surikaterna/redemeine/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/surikaterna/redemeine/issues"
  },
  "keywords": [
    "redemeine",
    "cqrs",
    "event-sourcing",
    "testing",
    "test-utilities",
    "harness"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm exec jest --config ../../jest.config.js --roots packages/testing/test",
    "lint": "tsc --noEmit",
    "bench": "pnpm exec tsx bench/testing-suite.bench.ts"
  },
  "dependencies": {
    "@redemeine/mirage": "workspace:*",
    "@redemeine/projection": "workspace:*",
    "@redemeine/projection-runtime-core": "workspace:*",
    "@redemeine/projection-runtime-store-inmemory": "workspace:*",
    "@redemeine/saga": "workspace:*",
    "immer": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
